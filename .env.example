# wp-memlog environment template
# Copy this file to .env and fill in the values

# Project
COMPOSE_PROJECT_NAME=wp-memlog

# Meilisearch
MEILI_MASTER_KEY=<random-32-char>
MEILI_NO_ANALYTICS=true

# MariaDB
MYSQL_ROOT_PASSWORD=<random-24-char>
MYSQL_DATABASE=wp_memlog
MYSQL_USER=wp
MYSQL_PASSWORD=<random-24-char>
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci

# WordPress
WORDPRESS_DB_HOST=db
WORDPRESS_DB_USER=wp
WORDPRESS_DB_PASSWORD=<same-as-MYSQL_PASSWORD>
WORDPRESS_DB_NAME=wp_memlog

# WordPress Application Passwords (set in WP admin)
# WP_MEMLOG_WP_USER=memlog_writer
# WP_MEMLOG_WP_APPPW=<app-password>

# Meilisearch API Keys (get from: docker exec wp-memlog-meilisearch curl -H "Authorization: Bearer $MEILI_MASTER_KEY" http://localhost:7700/keys)
# WP_MEMLOG_MEILI_KEY=<admin-or-search-key>

# OpenRouter (for enrichment)
# Get free key from https://openrouter.ai/keys
OPENROUTER_API_KEY=<openrouter-api-key>

# Monitoring (optional - for Telegram alerts)
# TG_TOKEN=
# TG_CHAT_ID=